{
  "name": "@edugis-org/webmapx",
  "version": "0.2.2",
  "description": "A modular web map UI with built-in adapters for MapLibre, OpenLayers, Leaflet, and Cesium.",
  "license": "ISC",
  "author": "Anne Blankert",
  "type": "module",
  "main": "dist-lib/webmapx.js",
  "module": "dist-lib/webmapx.js",
  "exports": {
    ".": {
      "import": "./dist-lib/webmapx.js"
    }
  },
  "files": [
    "dist-lib",
    "src/locales",
    "public/data"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "start": "vite --open --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "test:unit": "node ./scripts/run-tests.mjs",
    "test": "npm run typecheck && npm run lint && npm run check:architecture && npm run test:unit",
    "ui-test": "node ./scripts/run-ui-tests.mjs --all",
    "ui-test:tools": "node ./scripts/run-ui-tests.mjs --all",
    "ui-test:tool-draw": "node ./scripts/run-ui-tests.mjs --suite tool-draw",
    "ui-test:tool-draw:maplibre": "node ./scripts/run-ui-tests.mjs --suite tool-draw --engines maplibre",
    "ui-test:tool-draw:openlayers": "node ./scripts/run-ui-tests.mjs --suite tool-draw --engines openlayers",
    "ui-test:tool-draw:leaflet": "node ./scripts/run-ui-tests.mjs --suite tool-draw --engines leaflet",
    "ui-test:tool-draw:cesium": "node ./scripts/run-ui-tests.mjs --suite tool-draw --engines cesium",
    "ui-test:search-persist-draw": "node ./scripts/run-ui-tests.mjs --suite search-persist-draw",
    "ui-test:search-persist-draw:maplibre": "node ./scripts/run-ui-tests.mjs --suite search-persist-draw --engines maplibre",
    "ui-test:search-persist-draw:openlayers": "node ./scripts/run-ui-tests.mjs --suite search-persist-draw --engines openlayers",
    "ui-test:search-persist-draw:leaflet": "node ./scripts/run-ui-tests.mjs --suite search-persist-draw --engines leaflet",
    "ui-test:search-persist-draw:cesium": "node ./scripts/run-ui-tests.mjs --suite search-persist-draw --engines cesium",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "generate:swatches": "node ./scripts/run-ts.mjs scripts/generate-layer-swatches.ts",
    "generate:daynight": "node ./scripts/run-ts.mjs scripts/generate-daynight.ts",
    "generate:eclipse": "node ./scripts/run-ts.mjs scripts/generate-eclipse-geojson.ts",
    "allmaps:bounds": "node ./scripts/run-ts.mjs scripts/allmaps-bounds.ts",
    "postinstall": "node -e \"if(process.env.INIT_CWD===process.cwd()){require('child_process').execSync('npx playwright install chromium',{stdio:'inherit'})}\""
  },
  "peerDependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "cesium": "^1.136.0",
    "leaflet": "^1.9.4",
    "lit": "^3.3.1",
    "maplibre-gl": "^5.24.0",
    "ol": "^10.7.0",
    "ol-mapbox-style": "^13.2.0"
  },
  "peerDependenciesMeta": {
    "cesium": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "ol": {
      "optional": true
    },
    "ol-mapbox-style": {
      "optional": true
    }
  },
  "dependencies": {
    "@allmaps/leaflet": "^1.0.0-beta.52",
    "@allmaps/maplibre": "^1.0.0-beta.41",
    "@allmaps/openlayers": "^1.0.0-beta.84",
    "@camptocamp/ogc-client": "^1.3.0",
    "@edugis/cartogram": "^0.1.4",
    "@simonwep/pickr": "^1.9.1",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/bbox": "^7.3.5",
    "@turf/bearing": "^7.3.5",
    "@turf/boolean-intersects": "^7.3.5",
    "@turf/destination": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/union": "^7.3.5",
    "@types/papaparse": "^5.5.2",
    "d3-delaunay": "^6.0.4",
    "dompurify": "^3.4.8",
    "flatbush": "^4.6.2",
    "gdal3.js": "^2.8.1",
    "go-cart-wasm": "^0.5.0",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "papaparse": "^5.5.4",
    "polylabel": "^2.1.0",
    "proj4": "^2.20.2",
    "shpjs": "^6.2.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shoelace-style/shoelace": "^2.20.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/shpjs": "^3.4.7",
    "@types/topojson-client": "^3.1.5",
    "cesium": "^1.136.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.11.0",
    "leaflet": "^1.9.4",
    "lit": "^3.3.1",
    "maplibre-gl": "^5.24.0",
    "ol": "^10.7.0",
    "ol-mapbox-style": "^13.2.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
