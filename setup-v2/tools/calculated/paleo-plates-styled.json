{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-paleo-plates-styled",
    "title": "Palaeo plate boundaries",
    "description": "Documentation demo for the calculated layer paleo-plates.",
    "language": "en"
  },
  "map": {
    "label": "Palaeo plate boundaries",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "paleo-plates-source",
        "type": "geojson",
        "data": "internalfunc://paleo-plates?data=../../config/data/paleo/muller2019/plates&ma={ma}",
        "attribution": "Müller et al. 2019 plate model, topologies via GPlates Web Service"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "paleo-deforming",
        "type": "fill",
        "title": "Palaeo plate boundaries — styled as in deeptime.json",
        "source": "paleo-plates-source",
        "filter": [
          "==",
          [
            "get",
            "deforming"
          ],
          true
        ],
        "paint": {
          "fill-color": "#e63946",
          "fill-opacity": 0.35,
          "fill-outline-color": "#7a1420"
        },
        "metadata": {
          "abstract": "Where crust is being stretched or squeezed rather than moving rigidly — the collision zones. Müller et al. 2019."
        }
      },
      {
        "id": "paleo-plate-boundaries",
        "type": "line",
        "title": "Plate boundaries",
        "source": "paleo-plates-source",
        "paint": {
          "line-color": "#33302b",
          "line-width": 1.2,
          "line-opacity": 0.9
        },
        "metadata": {
          "abstract": "Plate boundaries at the age on the slider, sampled every 10 Ma. Müller et al. 2019."
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "paleo-deforming",
        "visible": true
      },
      {
        "ref": "paleo-plate-boundaries",
        "visible": true
      }
    ]
  },
  "tools": {
    "deeptime": {
      "type": "deeptime",
      "enabled": true,
      "data": "../../config/data/paleo/merdith2021",
      "to": 1000,
      "models": [
        {
          "id": "merdith2021",
          "label": "Merdith 2021 — 1000 Ma",
          "data": "../../config/data/paleo/merdith2021",
          "to": 1000
        },
        {
          "id": "muller2019",
          "label": "Müller 2019 — 250 Ma",
          "data": "../../config/data/paleo/muller2019",
          "to": 250,
          "plates": "../../config/data/paleo/muller2019/plates"
        }
      ]
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "deeptime",
          "id": "deeptime",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}