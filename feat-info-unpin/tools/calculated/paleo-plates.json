{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-paleo-plates",
    "title": "Palaeo plate boundaries",
    "description": "Documentation demo for the calculated layer paleo-plates.",
    "language": "en"
  },
  "map": {
    "label": "Palaeo plate boundaries",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "calculated-source",
        "type": "geojson",
        "data": "internalfunc://paleo-plates?data=../../config/data/paleo/muller2019/plates&ma={ma}",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "calculated",
        "type": "style",
        "title": "Palaeo plate boundaries (computed)",
        "sources": {
          "calculated": {
            "type": "geojson",
            "data": "internalfunc://paleo-plates?data=../../config/data/paleo/muller2019/plates&ma={ma}",
            "attribution": "Computed in the browser"
          }
        },
        "layers": [
          {
            "id": "calculated-fill",
            "type": "fill",
            "source": "calculated",
            "paint": {
              "fill-color": "rgba(43,108,143,0.35)",
              "fill-outline-color": "#1b4a63"
            },
            "metadata": {
              "label": "Areas"
            }
          },
          {
            "id": "calculated-line",
            "type": "line",
            "source": "calculated",
            "paint": {
              "line-color": "#1b4a63",
              "line-width": 1.5
            },
            "metadata": {
              "label": "Lines"
            }
          }
        ],
        "metadata": {
          "abstract": "Plate boundaries and deforming networks at a chosen age. Snapshots rather than a reconstruction: boundaries are born, die and change in number, so there is nothing to interpolate between two ages.",
          "title": "Palaeo plate boundaries (computed)"
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "calculated",
        "visible": true
      }
    ]
  },
  "tools": {
    "deeptime": {
      "type": "deeptime",
      "enabled": true,
      "data": "../../config/data/paleo/merdith2021",
      "to": 1000,
      "models": [
        {
          "id": "merdith2021",
          "label": "Merdith 2021 — 1000 Ma",
          "data": "../../config/data/paleo/merdith2021",
          "to": 1000
        },
        {
          "id": "muller2019",
          "label": "Müller 2019 — 250 Ma",
          "data": "../../config/data/paleo/muller2019",
          "to": 250,
          "plates": "../../config/data/paleo/muller2019/plates"
        }
      ]
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "deeptime",
          "id": "deeptime",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}