{
  "version": 0,
  "apiKeysFile": "../../apikeys.json",
  "project": {
    "id": "docs-cartogram",
    "title": "Cartogram",
    "description": "Documentation demo for the cartogram tool: world countries carrying a population estimate, ready to be resized by it.",
    "language": "en"
  },
  "map": {
    "label": "Cartogram",
    "type": "openlayers",
    "center": [
      0,
      10
    ],
    "zoom": 0.6,
    "backgroundColor": "#dce8f0",
    "projection": "EPSG:8857"
  },
  "layerData": {
    "sources": [
      {
        "id": "countries-source",
        "type": "vector",
        "bounds": [
          -180,
          -89,
          180,
          83.6341006530001
        ],
        "tiles": [
          "https://tiles.edugis.nl/data/public.ne_10m_admin_0_countries/mvt/{z}/{x}/{y}?geom_column=geom&columns=name,pop_est&include_nulls=0"
        ],
        "attribution": "Natural Earth"
      }
    ],
    "layers": [
      {
        "id": "countries",
        "type": "fill",
        "title": "Countries — population",
        "source": "countries-source",
        "source-layer": "public.ne_10m_admin_0_countries",
        "paint": {
          "fill-color": "#4f86a8",
          "fill-opacity": 0.75,
          "fill-outline-color": "#1d3f56"
        },
        "metadata": {
          "title": "Countries — population",
          "abstract": "Natural Earth country polygons carrying a population estimate (<code>pop_est</code>). This is the input the cartogram tool resizes: an ordinary polygon layer with one numeric attribute. Any layer of yours with those two properties works the same way.",
          "attributes": {
            "translations": [
              {
                "name": "name",
                "translation": "country",
                "unit": ""
              },
              {
                "name": "pop_est",
                "translation": "population",
                "unit": " inh"
              }
            ]
          }
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "countries",
        "visible": true
      }
    ]
  },
  "tools": {
    "cartogram": {
      "type": "cartogram",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        },
        {
          "type": "cartogram",
          "id": "cartogram",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    },
    "spinner": {
      "type": "spinner",
      "enabled": true,
      "position": "middle-center"
    },
    "projection": {
      "type": "projection",
      "enabled": true
    }
  }
}
