{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-moon-phase-styled",
    "title": "Moon phase",
    "description": "Documentation demo for the calculated layer moon-phase.",
    "language": "en"
  },
  "map": {
    "label": "Moon phase",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "type": "geojson",
        "data": "internalfunc://moon-phase?refresh=auto&radius=5.6&observer={click}",
        "attribution": "Computed in the browser",
        "id": "moon-position-source"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "moon-position",
        "title": "Moon phase — styled as in world.json",
        "type": "style",
        "sources": {
          "moon-position-source": {
            "type": "geojson",
            "data": "internalfunc://moon-phase?refresh=auto&radius=5.6&observer={click}",
            "attribution": "Computed in the browser"
          }
        },
        "layers": [
          {
            "id": "moon-position-horizon",
            "type": "line",
            "source": "moon-position-source",
            "filter": [
              "==",
              [
                "get",
                "id"
              ],
              "horizon"
            ],
            "paint": {
              "line-color": "#8d93b5",
              "line-width": 1.5,
              "line-opacity": [
                "case",
                [
                  "any",
                  [
                    "get",
                    "belowHorizon"
                  ],
                  [
                    "get",
                    "daylight"
                  ]
                ],
                0.35,
                0.9
              ]
            }
          },
          {
            "id": "moon-position-disc",
            "type": "fill",
            "source": "moon-position-source",
            "filter": [
              "==",
              [
                "get",
                "id"
              ],
              "disc"
            ],
            "paint": {
              "fill-color": "#2f3350",
              "fill-opacity": [
                "case",
                [
                  "any",
                  [
                    "get",
                    "belowHorizon"
                  ],
                  [
                    "get",
                    "daylight"
                  ]
                ],
                0.3,
                0.85
              ],
              "fill-outline-color": "#8d93b5"
            }
          },
          {
            "id": "moon-position-lit",
            "type": "fill",
            "source": "moon-position-source",
            "filter": [
              "==",
              [
                "get",
                "id"
              ],
              "lit"
            ],
            "paint": {
              "fill-color": "#f5eccd",
              "fill-opacity": [
                "case",
                [
                  "any",
                  [
                    "get",
                    "belowHorizon"
                  ],
                  [
                    "get",
                    "daylight"
                  ]
                ],
                0.35,
                0.95
              ],
              "fill-outline-color": "#f5eccd"
            }
          },
          {
            "id": "moon-position-observer",
            "type": "circle",
            "source": "moon-position-source",
            "filter": [
              "==",
              [
                "get",
                "id"
              ],
              "observer"
            ],
            "paint": {
              "circle-radius": 5,
              "circle-color": [
                "case",
                [
                  "get",
                  "belowHorizon"
                ],
                "#8d93b5",
                "#f5eccd"
              ],
              "circle-stroke-width": 2,
              "circle-stroke-color": "#2f3350"
            }
          }
        ],
        "metadata": {
          "title": "Maanstand",
          "abstract": "Where the moon stands overhead, drawn at the size of the sun marker and shaded to show how much of it is lit. How much is lit is the same for everyone on Earth. Which way the lit side is turned is not: that is measured against somebody's horizon, and directly under the moon there is no such measure, because a point straight overhead has no compass direction. So by itself this marker claims no angle — the terminator simply follows the direction to the sun over the ground, and no horizon is drawn. Click anywhere on the map and it becomes a view instead: the crescent is turned the way it hangs over that place, a horizon appears under it, and a dot marks the place you chose. Click Paramaribo and the horns point up like a boat; click Amsterdam and the same moon stands on its edge. If the moon is below the horizon there, or the sky is bright, it is drawn faintly — nobody there is looking at this. Any click will do, including the info tool's, so no tool has to be switched on for it.",
          "attributes": {
            "translations": [
              {
                "name": "phaseName",
                "translation": "phase"
              },
              {
                "name": "illumination",
                "translation": "lit fraction"
              },
              {
                "name": "tilt",
                "translation": "angle from straight up",
                "unit": "°"
              },
              {
                "name": "altitude",
                "translation": "moon above the horizon",
                "unit": "°"
              },
              {
                "name": "sunAltitude",
                "translation": "sun above the horizon",
                "unit": "°"
              },
              {
                "name": "observerLat",
                "translation": "seen from latitude"
              },
              {
                "name": "observerLon",
                "translation": "seen from longitude"
              },
              {
                "name": "description",
                "translation": "what this is"
              }
            ]
          }
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "moon-position",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "timeSlider",
          "id": "timeSlider",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}