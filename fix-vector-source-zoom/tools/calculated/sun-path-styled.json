{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-sun-path-styled",
    "title": "Sun path",
    "description": "Documentation demo for the calculated layer sun-path.",
    "language": "en"
  },
  "map": {
    "label": "Sun path",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "sunpath-computed-source",
        "type": "geojson",
        "data": "internalfunc://sun-path",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "sunpath-computed",
        "type": "line",
        "title": "Sun path — styled as in demo.json",
        "source": "sunpath-computed-source",
        "paint": {
          "line-color": [
            "interpolate",
            [
              "linear"
            ],
            [
              "get",
              "declination"
            ],
            -23.5,
            "#2166ac",
            0,
            "#6a51a3",
            23.5,
            "#b2182b"
          ],
          "line-width": [
            "case",
            [
              "!=",
              [
                "get",
                "solstice"
              ],
              null
            ],
            2.2,
            0.7
          ],
          "line-opacity": 0.8
        },
        "metadata": {
          "title": "Sun paths | solstice to solstice",
          "abstract": "The track the overhead sun takes each day, one line per day from the June solstice on the Tropic of Cancer to the December solstice on the Tropic of Capricorn. The return half of the year retraces the same latitudes, so it is not drawn. The lines crowd at the solstices, where the sun turns, and spread at the equinox, where it crosses the equator fastest — the spacing is the seasons.",
          "attributes": {
            "translations": [
              {
                "name": "date",
                "translation": "date",
                "unit": ""
              },
              {
                "name": "declination",
                "translation": "declination",
                "unit": "°"
              }
            ]
          }
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "sunpath-computed",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "timeSlider",
          "id": "timeSlider",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}