{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-equilibrium-tide",
    "title": "Equilibrium tide",
    "description": "Documentation demo for the calculated layer equilibrium-tide.",
    "language": "en"
  },
  "map": {
    "label": "Equilibrium tide",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "calculated-source",
        "type": "geojson",
        "data": "internalfunc://equilibrium-tide?levels=-0.2,0,0.3&refresh=auto",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "calculated",
        "type": "style",
        "title": "Equilibrium tide (computed)",
        "sources": {
          "calculated": {
            "type": "geojson",
            "data": "internalfunc://equilibrium-tide?levels=-0.2,0,0.3&refresh=auto",
            "attribution": "Computed in the browser"
          }
        },
        "layers": [
          {
            "id": "calculated-line",
            "type": "line",
            "source": "calculated",
            "paint": {
              "line-color": "#1b4a63",
              "line-width": 1.5
            },
            "metadata": {
              "label": "Lines"
            }
          },
          {
            "id": "calculated-circle",
            "type": "circle",
            "source": "calculated",
            "filter": [
              "match",
              [
                "geometry-type"
              ],
              [
                "Point",
                "MultiPoint"
              ],
              true,
              false
            ],
            "paint": {
              "circle-color": "#d9633c",
              "circle-radius": 5,
              "circle-stroke-color": "#fff",
              "circle-stroke-width": 1.5
            },
            "metadata": {
              "label": "Points"
            }
          }
        ],
        "metadata": {
          "abstract": "The shape the ocean would take if water could keep up with the moon and the sun — two bulges, one under the moon and one opposite. It is the *forcing*, not a tide table: real tides lag it by hours and are shaped by coastlines.",
          "title": "Equilibrium tide (computed)"
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "calculated",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "timeSlider",
          "id": "timeSlider",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}