{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-reference-circles-styled",
    "title": "Reference circles",
    "description": "Documentation demo for the calculated layer reference-circles.",
    "language": "en"
  },
  "map": {
    "label": "Reference circles",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "reference-circles-source",
        "type": "geojson",
        "data": "internalfunc://reference-circles",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "reference-circles",
        "type": "line",
        "title": "Reference circles — styled as in demo.json",
        "source": "reference-circles-source",
        "paint": {
          "line-color": [
            "match",
            [
              "get",
              "id"
            ],
            "equator",
            "#d62728",
            "cancer",
            "#ff7f0e",
            "capricorn",
            "#ff7f0e",
            "#1f77b4"
          ],
          "line-width": 1.6,
          "line-dasharray": [
            3,
            2
          ]
        },
        "metadata": {
          "title": "Equator, tropics and polar circles",
          "abstract": "Computed from the tilt of the Earth on this date. The tilt drifts, so the tropics and polar circles move about ten metres a year — an atlas from 1926 has them half a kilometre out."
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "reference-circles",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "timeSlider",
          "id": "timeSlider",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}