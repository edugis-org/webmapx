{
  "version": 0,
  "apiKeysFile": "../../apikeys.json",
  "project": {
    "id": "docs-buffer",
    "title": "Buffer",
    "description": "Documentation demo for the buffer tool: one polygon layer to draw a zone around.",
    "language": "en"
  },
  "map": {
    "label": "Buffer",
    "type": "maplibre",
    "center": [
      10,
      45
    ],
    "zoom": 4
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "countries-source",
        "type": "vector",
        "bounds": [
          -180,
          -89,
          180,
          83.6341006530001
        ],
        "tiles": [
          "https://tiles.edugis.nl/data/public.ne_10m_admin_0_countries/mvt/{z}/{x}/{y}?geom_column=geom&columns=name,pop_est&include_nulls=0"
        ],
        "attribution": "Natural Earth"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9",
          "abstract": "Plain OpenStreetMap raster tiles. A measurement needs something recognisable underneath it — a canal, a block, a runway — so the numbers can be checked against the world."
        }
      },
      {
        "id": "countries",
        "type": "fill",
        "title": "Countries — population",
        "source": "countries-source",
        "source-layer": "public.ne_10m_admin_0_countries",
        "paint": {
          "fill-color": "#4f86a8",
          "fill-opacity": 0.75,
          "fill-outline-color": "#1d3f56"
        },
        "metadata": {
          "title": "Countries — population",
          "abstract": "Natural Earth country polygons carrying a population estimate (<code>pop_est</code>). This is the input the cartogram tool resizes: an ordinary polygon layer with one numeric attribute. Any layer of yours with those two properties works the same way.",
          "attributes": {
            "translations": [
              {
                "name": "name",
                "translation": "country",
                "unit": ""
              },
              {
                "name": "pop_est",
                "translation": "population",
                "unit": " inh"
              }
            ]
          }
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "countries",
        "visible": true
      }
    ]
  },
  "tools": {
    "buffer": {
      "type": "buffer",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "buffer",
          "id": "buffer",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}
