{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-moon-path",
    "title": "Moon path",
    "description": "Documentation demo for the calculated layer moon-path.",
    "language": "en"
  },
  "map": {
    "label": "Moon path",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "calculated-source",
        "type": "geojson",
        "data": "internalfunc://moon-path?days=27.32&step=1",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "calculated",
        "type": "style",
        "title": "Moon path (computed)",
        "sources": {
          "calculated": {
            "type": "geojson",
            "data": "internalfunc://moon-path?days=27.32&step=1",
            "attribution": "Computed in the browser"
          }
        },
        "layers": [
          {
            "id": "calculated-line",
            "type": "line",
            "source": "calculated",
            "paint": {
              "line-color": "#1b4a63",
              "line-width": 1.5
            },
            "metadata": {
              "label": "Lines"
            }
          }
        ],
        "metadata": {
          "abstract": "The track of the sublunar point over a month, which turns the moon’s north–south swing into one picture.",
          "title": "Moon path (computed)"
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "calculated",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
