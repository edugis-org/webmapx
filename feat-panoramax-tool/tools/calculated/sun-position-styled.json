{
  "version": 0,
  "apiKeysFile": "../../config/apikeys.json",
  "project": {
    "id": "docs-calculated-sun-position-styled",
    "title": "Sun position",
    "description": "Documentation demo for the calculated layer sun-position.",
    "language": "en"
  },
  "map": {
    "label": "Sun position",
    "type": "maplibre",
    "center": [
      10,
      20
    ],
    "zoom": 1
  },
  "layerData": {
    "sources": [
      {
        "id": "osm-source",
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://tiles.edugis.nl/mapproxy/osm/tiles/osm_EPSG900913/{z}/{x}/{y}.png?origin=nw"
        ],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>"
      },
      {
        "id": "sunposition-computed-source",
        "type": "geojson",
        "data": "internalfunc://sun-position?refresh=auto",
        "attribution": "Computed in the browser"
      }
    ],
    "layers": [
      {
        "id": "osm",
        "type": "raster",
        "title": "OpenStreetMap",
        "source": "osm-source",
        "metadata": {
          "reference": true,
          "swatch": "#f2efe9"
        }
      },
      {
        "id": "sunposition-computed",
        "type": "circle",
        "title": "Sun position — styled as in demo.json",
        "source": "sunposition-computed-source",
        "paint": {
          "circle-color": "#FFD700",
          "circle-radius": 14,
          "circle-blur": 0.4,
          "circle-stroke-width": 2,
          "circle-stroke-color": "#FF8C00"
        },
        "metadata": {
          "title": "Sun position (computed)",
          "abstract": "The point the sun is directly overhead, right now, moving west at 464 metres a second as the Earth turns. Computed from the date and time rather than fetched, and redrawn continuously — at street zoom it glides across the screen, at world zoom it barely stirs. How far north or south the sun stands is a matter of the date — that is the seasons. How far east or west is a matter of the time: the Earth turns fifteen degrees an hour, so the sun crosses one degree of longitude every four minutes. But the clock is not quite the sun's: because the Earth's orbit is an ellipse and its axis is tilted, the sun reaches its highest point up to a quarter of an hour before or after twelve o'clock, depending on the month. That is taken into account here. Leaving it out shifts the sun up to four degrees of longitude — a quarter of an hour of turning, which measures about 450 km on the equator and less towards the poles."
        }
      }
    ]
  },
  "state": {
    "activeLayers": [
      {
        "ref": "osm",
        "visible": true
      },
      {
        "ref": "sunposition-computed",
        "visible": true
      }
    ]
  },
  "tools": {
    "timeSlider": {
      "type": "timeSlider",
      "enabled": true
    },
    "projection": {
      "type": "projection",
      "enabled": true
    },
    "info": {
      "type": "info",
      "enabled": true
    },
    "layerOverview": {
      "type": "layerOverview",
      "enabled": true
    },
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "orientation": "vertical",
      "items": [
        {
          "type": "timeSlider",
          "id": "timeSlider",
          "enabled": true
        },
        {
          "type": "projection",
          "id": "projection",
          "enabled": true
        },
        {
          "type": "info",
          "id": "info",
          "enabled": true
        },
        {
          "type": "layerOverview",
          "id": "layerOverview",
          "enabled": true
        }
      ]
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "top-right"
    },
    "fullscreen": {
      "type": "fullscreen",
      "enabled": true,
      "position": "top-right"
    },
    "attribution": {
      "type": "attribution",
      "enabled": true,
      "position": "edge-bottom-right"
    }
  }
}