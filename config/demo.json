        "type": "style",
        "url": "https://tiles.openfreemap.org/styles/liberty",
        "singleGroup": "basemap",
        "title": "OpenFreeMap Liberty (style)",
        "attribution": "\u00a9 OpenStreetMap contributors | \u00a9 OpenFreeMap",
        "fallbackLayerId": "osm",
        "layers": []
      },
      "earthquake": {
        "id": "earthquake",
        "type": "style",
        "title": "Earthquakes",
        "layers": [
          {
            "id": "earthquake-circles",
            "type": "circle",
            "source": "earthquake-source",
            "filter": [
              "all",
              [
                "==",
                [
                  "get",
                  "type"
                ],
                "earthquake"
              ],
              [
                "!=",
                [
                  "get",
                  "mag"
                ],
                null
              ]
            ],
            "paint": {
              "circle-color": [
                "interpolate",
                [
                  "linear"
                ],
                [
                  "coalesce",
                  [
                    "to-number",
                    [
                      "get",
                      "mag"
                    ]
                  ],
                  0
                ],
                0,
                "#faf207",
                2,
                "#faf207",
                4,
                "#faa907",
                6,
                "#fa6c07",
                8,
                "#fa0707"
              ],
              "circle-radius": [
                "interpolate",
                [
                  "exponential",
                  2
                ],
                [
                  "coalesce",
                  [
                    "to-number",
                    [
                      "get",
                      "mag"
                    ]
                  ],
                  0
                ],
                0,
                4,
                2,
                5,
                4,
                10,
                6,
                20,
                8,
                50
              ],
              "circle-stroke-color": "#818181",
              "circle-stroke-width": 1
            }
          }
        ]
      },
