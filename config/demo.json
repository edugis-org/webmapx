{
  "version": 1,
  "project": {
    "id": "demo-project",
    "title": "WebMapX Demo Project",
    "description": "Demo configuration using layerData/state structure",
    "language": "en"
  },
  "map": {
    "label": "Demo Map",
    "center": [0, 0],
    "zoom": 2,
    "type": "maplibre",
    "style": {
      "version": 8,
      "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
      "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
      "sources": {},
      "layers": []
    }
  },
  "runtimeMap": {
    "minZoom": 0,
    "maxZoom": 20,
    "minPitch": 0,
    "maxPitch": 85
  },
  "layerData": {
    "sources": {
      "xyz-source": {
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
        ],
        "tileSize": 256,
        "attribution": "© OpenStreetMap contributors",
        "maxzoom": 19
      },
      "google-satellite-source": {
        "type": "raster",
        "service": "xyz",
        "url": "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
        "tileSize": 256,
        "attribution": "© Google Satellite"
      },
      "transport-source": {
        "type": "geojson",
        "data": "https://data.example.com/transport_network.geojson",
        "attribution": "Example Transport Data"
      },
      "air-source": {
        "type": "geojson",
        "data": "https://data.example.com/air_quality.geojson",
        "attribution": "Example Air Quality Data"
      },
      "water-source": {
        "type": "geojson",
        "data": "https://data.example.com/water_quality.geojson",
        "attribution": "Example Water Quality Data"
      },
      "earthquake-source": {
        "type": "geojson",
        "data": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
        "attribution": "USGS Earthquake Data"
      }
    },
    "layers": {
      "osm": {
        "id": "osm",
        "type": "raster",
        "source": "xyz-source",
        "singleGroup": "basemap",
        "title": "OpenStreetMap (xyz)"
      },
      "google-satellite": {
        "id": "google-satellite",
        "type": "raster",
        "source": "google-satellite-source",
        "singleGroup": "basemap",
        "title": "Google Satellite"
      },
      "openfreemap-liberty": {
        "id": "openfreemap-liberty",
        "type": "style",
        "singleGroup": "basemap",
        "title": "OpenFreeMap Liberty (style)",
        "fallbackLayerId": "osm",
        "metadata": {
          "styleUrl": "https://tiles.openfreemap.org/styles/liberty"
        },
        "layers": []
      },
      "earthquake": {
        "id": "earthquake",
        "type": "style",
        "title": "Earthquakes",
        "layers": [
          {
            "id": "earthquake-circles",
            "type": "circle",
            "source": "earthquake-source",
            "filter": [
              "all",
              ["==", ["get", "type"], "earthquake"],
              ["!=", ["get", "mag"], null]
            ],
            "paint": {
              "circle-color": [
                "interpolate",
                ["linear"],
                ["coalesce", ["to-number", ["get", "mag"]], 0],
                0, "#faf207",
                2, "#faf207",
                4, "#faa907",
                6, "#fa6c07",
                8, "#fa0707"
              ],
              "circle-radius": ["interpolate", ["exponential", 2], ["coalesce", ["to-number", ["get", "mag"]], 0], 0, 4, 2, 5, 4, 10, 6, 20, 8, 50],
              "circle-stroke-color": "#818181",
              "circle-stroke-width": 1
            }
          }
        ]
      },
      "transport": {
        "id": "transport",
        "type": "line",
        "source": "transport-source",
        "title": "Transport Network"
      },
      "air": {
        "id": "air",
        "type": "circle",
        "source": "air-source",
        "title": "Air Quality"
      },
      "water": {
        "id": "water",
        "type": "circle",
        "source": "water-source",
        "title": "Water Quality"
      },
      "nyc-historical": {
        "id": "nyc-historical",
        "type": "allmaps",
        "annotation": "https://annotations.allmaps.org/images/d180902cb93d5bf2",
        "title": "NYC 1836 (Allmaps)"
      },
      "amsterdam-historical": {
        "id": "amsterdam-historical",
        "type": "allmaps",
        "annotation": "https://annotations.allmaps.org/maps/f60ecda322d09956",
        "title": "Amsterdam 1625 (Allmaps)"
      }
    }
  },
  "state": {
    "activeExclusiveLayers": {
      "basemap": "osm"
    },
    "activeLayers": [
      { "ref": "osm", "visible": true }
    ]
  },
  "tools": {
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "order": 10,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Tools",
        "position": "after"
      },
      "items": [
        {
          "id": "layers",
          "type": "layerTree",
          "enabled": true,
          "title": "Catalog",
          "icon": "layers",
          "tree": [
            {
              "label": "Base Maps",
              "selectionMode": "single",
              "selectionGroup": "basemap",
              "allowNone": false,
              "expanded": true,
              "children": [
                { "layerId": "openfreemap-liberty" },
                { "layerId": "osm" },
                { "layerId": "google-satellite" }
              ]
            },
            {
              "label": "Historical Maps",
              "expanded": true,
              "children": [
                { "layerId": "nyc-historical" },
                { "layerId": "amsterdam-historical" }
              ]
            },
            {
              "label": "Data Layers",
              "expanded": true,
              "children": [
                { "layerId": "earthquake" },
                { "layerId": "transport" },
                {
                  "label": "Environmental",
                  "children": [
                    { "layerId": "air" },
                    { "layerId": "water" }
                  ]
                }
              ]
            }
          ],
          "order": 10
        },
        {
          "id": "search",
          "type": "search",
          "enabled": true,
          "title": "Search",
          "icon": "search",
          "order": 20
        },
        {
          "id": "measure",
          "type": "measure",
          "enabled": true,
          "title": "Measure",
          "icon": "rulers",
          "order": 30
        },
        {
          "id": "settings",
          "type": "settings",
          "enabled": true,
          "title": "Settings",
          "icon": "gear",
          "order": 40
        },
        {
          "id": "geolocation",
          "type": "geolocation",
          "enabled": true,
          "title": "Geolocation",
          "icon": "crosshair",
          "order": 50
        }
      ]
    },
    "legendToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-right",
      "order": 20,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Legend",
        "position": "after",
        "opened": false
      },
      "items": [
        {
          "id": "legend",
          "type": "layerOverview",
          "enabled": true,
          "title": "Legend",
          "icon": "card-list",
          "order": 10
        }
      ]
    },
    "scale": {
      "type": "scaleControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 10,
      "maxWidth": 140
    },
    "attribution": {
      "type": "attributionControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 20
    },
    "coordinates": {
      "type": "coordinates",
      "enabled": true,
      "position": "bottom-center",
      "order": 10
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "bottom-left",
      "order": 10,
      "direction": "horizontal",
      "orientation": "vertical"
    },
    "zoomLevel": {
      "type": "zoomLevel",
      "enabled": true,
      "position": "bottom-left",
      "order": 20
    },
    "insetMap": {
      "type": "insetMap",
      "enabled": true,
      "position": "bottom-left",
      "order": 30,
      "zoomOffset": -4,
      "background": {
        "service": "xyz",
        "tiles": [
          "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
        ],
        "attribution": "&copy; OpenStreetMap contributors",
        "tileSize": 256
      }
    },
    "spinner": {
      "type": "spinner",
      "enabled": true,
      "position": "middle-center",
      "order": 10
    }
  }
}
