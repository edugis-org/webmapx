  "layerData": {
    "sources": {
      "xyz-source": {
        "type": "raster",
        "service": "xyz",
        "url": [
          "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
        ],
        "tileSize": 256,
        "attribution": "\u00a9 OpenStreetMap contributors",
        "maxzoom": 19
      },
      "google-satellite-source": {
        "type": "raster",
        "service": "xyz",
        "url": "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
        "tileSize": 256,
        "attribution": "\u00a9 Google Satellite"
      },
      "earthquake-source": {
        "type": "geojson",
        "data": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
        "attribution": "USGS Earthquake Data"
      },
      "countrypopest-source": {
        "type": "vector",
        "bounds": [
          -180,
          -89,
          180,
          83.6341006530001
        ],
        "tiles": [
          "https://tiles.edugis.nl/data/public.ne_10m_admin_0_countries/mvt/{z}/{x}/{y}?geom_column=geompoint&columns=name,pop_est&include_nulls=0"
        ],
        "attribution": "Natural Earth"
      },
