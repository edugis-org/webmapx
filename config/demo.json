{
  "version": 1,
  "project": {
    "id": "demo-project",
    "title": "WebMapX Demo Project",
    "description": "Demo configuration using library/state structure",
    "language": "en"
  },
  "map": {
    "label": "Demo Map",
    "center": [0, 0],
    "zoom": 2,
    "maxZoom": 20,
    "minZoom": 0,
    "type": "maplibre"
  },
  "library": {
    "sources": {
      "xyz-source": {
        "type": "raster",
        "service": "xyz",
        "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "tileSize": 256,
        "attribution": "© OpenStreetMap contributors",
        "maxzoom": 19
      },
      "google-satellite-source": {
        "type": "raster",
        "service": "xyz",
        "url": "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
        "tileSize": 256,
        "attribution": "© Google Satellite"
      },
      "earthquake-source": {
        "type": "geojson",
        "data": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
        "attribution": "USGS Earthquake Data"
      },
      "transport-source": {
        "type": "geojson",
        "data": "https://data.example.com/transport_network.geojson"
      },
      "air-source": {
        "type": "geojson",
        "data": "https://data.example.com/air_quality.geojson"
      },
      "water-source": {
        "type": "geojson",
        "data": "https://data.example.com/water_quality.geojson"
      },
      "nyc-historical-source": {
        "type": "raster",
        "service": "xyz",
        "url": "warpedmap://annotations.allmaps.org/images/d180902cb93d5bf2",
        "attribution": "NYPL via Allmaps"
      },
      "amsterdam-historical-source": {
        "type": "raster",
        "service": "xyz",
        "url": "warpedmap://annotations.allmaps.org/maps/f60ecda322d09956",
        "attribution": "via Allmaps"
      }
    },
    "layers": {
      "osm": {
        "kind": "single",
        "title": "OpenStreetMap (xyz)",
        "source": "xyz-source",
        "render": {
          "type": "raster"
        }
      },
      "google-satellite": {
        "kind": "single",
        "title": "Google Satellite",
        "source": "google-satellite-source",
        "render": {
          "type": "raster"
        }
      },
      "earthquake": {
        "kind": "single",
        "title": "Earthquakes",
        "source": "earthquake-source",
        "render": {
          "type": "circle",
          "paint": {
            "circle-color": "#FF5722",
            "circle-radius": 14,
            "circle-opacity": 0.8,
            "circle-stroke-color": "#FFFFFF",
            "circle-stroke-width": 1
          }
        }
      },
      "transport": {
        "kind": "single",
        "title": "Transport Network",
        "source": "transport-source",
        "render": {
          "type": "line"
        }
      },
      "air": {
        "kind": "single",
        "title": "Air Quality",
        "source": "air-source",
        "render": {
          "type": "circle"
        }
      },
      "water": {
        "kind": "single",
        "title": "Water Quality",
        "source": "water-source",
        "render": {
          "type": "circle"
        }
      },
      "nyc-historical": {
        "kind": "single",
        "title": "NYC 1836 (Allmaps)",
        "source": "nyc-historical-source",
        "render": {
          "type": "raster"
        }
      },
      "amsterdam-historical": {
        "kind": "single",
        "title": "Amsterdam 1625 (Allmaps)",
        "source": "amsterdam-historical-source",
        "render": {
          "type": "raster"
        }
      }
    },
    "catalogs": {
      "main": {
        "title": "Demo Catalog",
        "items": [
          {
            "kind": "group",
            "title": "Base Maps",
            "expanded": true,
            "children": [
              { "kind": "layer", "title": "OpenStreetMap (xyz)", "ref": "osm" },
              { "kind": "layer", "title": "Google Satellite", "ref": "google-satellite" }
            ]
          },
          {
            "kind": "group",
            "title": "Historical Maps",
            "expanded": true,
            "children": [
              { "kind": "layer", "title": "NYC 1836 (Allmaps)", "ref": "nyc-historical" },
              { "kind": "layer", "title": "Amsterdam 1625 (Allmaps)", "ref": "amsterdam-historical" }
            ]
          },
          {
            "kind": "group",
            "title": "Data Layers",
            "expanded": true,
            "children": [
              { "kind": "layer", "title": "Earthquakes", "ref": "earthquake" },
              { "kind": "layer", "title": "Transport Network", "ref": "transport" },
              {
                "kind": "group",
                "title": "Environmental",
                "children": [
                  { "kind": "layer", "title": "Air Quality", "ref": "air" },
                  { "kind": "layer", "title": "Water Quality", "ref": "water" }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "activeBackground": "osm",
    "activeLayers": [
      { "ref": "transport", "visible": true }
    ]
  },
  "tools": {
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "order": 10,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Tools",
        "position": "after"
      },
      "items": [
        {
          "id": "catalog",
          "type": "layerTree",
          "enabled": true,
          "title": "Catalog",
          "icon": "layers",
          "catalog": "main",
          "order": 10
        },
        {
          "id": "search",
          "type": "search",
          "enabled": true,
          "title": "Search",
          "icon": "search",
          "order": 20
        },
        {
          "id": "measure",
          "type": "measure",
          "enabled": true,
          "title": "Measure",
          "icon": "rulers",
          "order": 30
        },
        {
          "id": "settings",
          "type": "settings",
          "enabled": true,
          "title": "Settings",
          "icon": "gear",
          "order": 40
        },
        {
          "id": "geolocation",
          "type": "geolocation",
          "enabled": true,
          "title": "Geolocation",
          "icon": "crosshair",
          "order": 50
        }
      ]
    },
    "legendToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-right",
      "order": 20,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Legend",
        "position": "after",
        "opened": false
      },
      "items": [
        {
          "id": "legend",
          "type": "layerOverview",
          "enabled": true,
          "title": "Legend",
          "icon": "card-list",
          "order": 10
        }
      ]
    },
    "scale": {
      "type": "scaleControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 10,
      "maxWidth": 140
    },
    "attribution": {
      "type": "attributionControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 20
    },
    "coordinates": {
      "type": "coordinates",
      "enabled": true,
      "position": "bottom-center",
      "order": 10
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "bottom-left",
      "order": 10,
      "direction": "horizontal",
      "orientation": "vertical"
    },
    "zoomLevel": {
      "type": "zoomLevel",
      "enabled": true,
      "position": "bottom-left",
      "order": 20
    },
    "insetMap": {
      "type": "insetMap",
      "enabled": true,
      "position": "bottom-left",
      "order": 30,
      "zoomOffset": -4
    },
    "spinner": {
      "type": "spinner",
      "enabled": true,
      "position": "middle-center",
      "order": 10
    }
  }
}
