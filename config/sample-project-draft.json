{
  "version": 1,
  "project": {
    "id": "sample-project-draft",
    "title": "Sample Project Draft",
    "description": "Draft WebMapX project configuration example",
    "language": "en"
  },
  "map": {
    "center": [4.8967, 52.3728],
    "zoom": 11,
    "pitch": 0,
    "bearing": 0,
    "srs": "EPSG:3857",
    "backgroundColor": "#f5f3ef",
    "type": "maplibre"
  },
  "runtimeMap": {
    "minZoom": 0,
    "maxZoom": 24,
    "minPitch": 0,
    "maxPitch": 85
  },
  "library": {
    "sources": {
      "osmraster": {
        "type": "raster",
        "tiles": [
          "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
        ],
        "tileSize": 256,
        "attribution": "© OpenStreetMap contributors"
      },
      "pdok-luchtfoto": {
        "type": "raster",
        "tiles": [
          "https://service.pdok.nl/hwh/luchtfotorgb/wms/v1_0?service=WMS&version=1.1.1&request=GetMap&layers=Actueel_orthoHR&styles=&format=image/png&transparent=true&srs={requestCrs}&bbox={bbox-epsg-3857}&width=256&height=256"
        ],
        "tileSize": 256,
        "requestCrs": "EPSG:3857",
        "bounds": [2.75, 50.5, 7.5, 53.6],
        "auth": {
          "credentialRef": "pdokApiKey"
        },
        "attribution": "PDOK"
      },
      "knmi-temperature": {
        "type": "raster",
        "tiles": [
          "https://example.org/wmst/temperature/{time}/{z}/{x}/{y}.png"
        ],
        "tileSize": 256,
        "requestCrs": "EPSG:3857",
        "attribution": "Example temporal service"
      }
    },
    "layers": {
      "osm-bright": {
        "kind": "composite",
        "title": "OSM Bright",
        "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
        "sprite": "https://demotiles.maplibre.org/styles/osm-bright-gl-style/sprite",
        "sources": {
          "openmaptiles": {
            "type": "vector",
            "url": "https://demotiles.maplibre.org/tiles/tiles.json"
          }
        },
        "renderLayers": [
          {
            "id": "background",
            "type": "background",
            "paint": {
              "background-color": "#f8f4f0"
            }
          },
          {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
              "fill-color": "#a0c8f0"
            }
          }
        ],
        "metadata": {
          "webmapx:description": "Composite OSM vector rendering",
          "webmapx:thumbnail": "img/osm-bright.png"
        }
      },
      "traffic-speed-amsterdam": {
        "kind": "composite",
        "title": "Traffic Speed Amsterdam",
        "sources": {
          "traffic": {
            "type": "geojson",
            "data": "data/traffic-speed-amsterdam.geojson",
            "attribution": "StevenF"
          }
        },
        "renderLayers": [
          {
            "id": "traffic-speed-highway",
            "type": "line",
            "source": "traffic",
            "filter": [
              "all",
              ["==", "$type", "LineString"],
              ["==", ["get", "Type"], "H"]
            ],
            "paint": {
              "line-color": [
                "step",
                ["get", "Velocity"],
                "#D0D0D0",
                1,   "#BE0000",
                30,  "#FF0000",
                50,  "#FF9E00",
                70,  "#FFFF00",
                90,  "#AAFF00",
                120, "#00B22D"
              ],
              "line-width": 4
            }
          },
          {
            "id": "traffic-speed-other",
            "type": "line",
            "source": "traffic",
            "filter": [
              "all",
              ["==", "$type", "LineString"],
              ["!=", ["get", "Type"], "H"]
            ],
            "paint": {
              "line-color": "#377eb8",
              "line-width": 2
            }
          }
        ],
        "metadata": {
          "webmapx:description": "Realtime traffic speed lines",
          "webmapx:icon": "traffic",
          "webmapx:attributes": {
            "properties": [
              { "name": "Type", "type": "string" },
              { "name": "Velocity", "type": "number" }
            ],
            "translations": [
              { "name": "Type", "translation": "wegtype" },
              { "name": "Velocity", "translation": "snelheid" }
            ]
          }
        }
      },
      "osm-standard-raster": {
        "kind": "single",
        "title": "OSM Standard Raster",
        "source": "osmraster",
        "render": {
          "type": "raster"
        },
        "metadata": {
          "webmapx:description": "OSM raster tile rendering",
          "webmapx:thumbnail": "img/osm-standard-raster.png"
        }
      },
      "pdok-luchtfoto-wms": {
        "kind": "single",
        "title": "PDOK Luchtfoto WMS",
        "source": "pdok-luchtfoto",
        "render": {
          "type": "raster"
        },
        "metadata": {
          "webmapx:description": "Authenticated raster imagery",
          "webmapx:thumbnail": "img/pdok-luchtfoto-wms.png"
        }
      },
      "knmi-temperature-time": {
        "kind": "single",
        "title": "Temperature (time-aware)",
        "source": "knmi-temperature",
        "render": {
          "type": "raster",
          "paint": {
            "raster-opacity": 0.75
          }
        },
        "metadata": {
          "webmapx:description": "Example temporal raster layer",
          "webmapx:timeAware": true,
          "webmapx:time": {
            "default": "2024-01-15T12:00:00Z",
            "interval": "PT1H"
          }
        }
      },
      "drawn-lines": {
        "kind": "single",
        "title": "lijnenlaag",
        "source": {
          "type": "geojson",
          "data": {
            "type": "FeatureCollection",
            "features": [
              {
                "id": "4e524b8d03d20056ca8ab5e9950c2c5f",
                "type": "Feature",
                "properties": {
                  "id": 1,
                  "name": "test"
                },
                "geometry": {
                  "type": "LineString",
                  "coordinates": [
                    [1.561514217719747, 48.33611770695572],
                    [6.671924384825104, 52.14650599849975],
                    [14.62145131143265, 49.82367545973136],
                    [12.917981255730552, 45.026363081422176]
                  ]
                }
              }
            ]
          },
          "attribution": "EduGIS"
        },
        "render": {
          "type": "line",
          "paint": {
            "line-color": "#000000",
            "line-width": 3
          }
        },
        "metadata": {
          "webmapx:description": "User drawn line layer",
          "webmapx:attributes": {
            "properties": [
              { "name": "id", "type": "number" },
              { "name": "name", "type": "string" }
            ],
            "translations": [
              { "name": "name", "translation": "naam" }
            ]
          }
        }
      }
    },
    "catalogs": {
      "main": {
        "title": "Main catalog",
        "items": [
          {
            "kind": "group",
            "title": "Background layers",
            "children": [
              { "kind": "layer", "ref": "osm-bright" },
              { "kind": "layer", "ref": "osm-standard-raster" },
              { "kind": "layer", "ref": "pdok-luchtfoto-wms" }
            ]
          },
          {
            "kind": "group",
            "title": "Theme layers",
            "children": [
              { "kind": "layer", "ref": "traffic-speed-amsterdam" },
              { "kind": "layer", "ref": "knmi-temperature-time" }
            ]
          },
          {
            "kind": "group",
            "title": "Drawings",
            "children": [
              { "kind": "layer", "ref": "drawn-lines" }
            ]
          }
        ]
      }
    },
    "backgroundSets": {
      "default": {
        "preferred": "osm-bright",
        "fallbacks": {
          "openlayers": "pdok-luchtfoto-wms",
          "leaflet": "osm-standard-raster",
          "cesium": "osm-standard-raster"
        }
      }
    }
  },
  "state": {
    "activeBackground": "osm-bright",
    "activeLayers": [
      {
        "id": "traffic-speed-amsterdam#1",
        "ref": "traffic-speed-amsterdam",
        "visible": true
      },
      {
        "id": "knmi-temperature-time#1",
        "ref": "knmi-temperature-time",
        "visible": true,
        "timeState": {
          "selectedTime": "2024-01-15T12:00:00Z"
        }
      },
      {
        "id": "drawn-lines#1",
        "ref": "drawn-lines",
        "visible": true,
        "paint": {
          "line-color": "#cc0000"
        }
      },
      {
        "id": "local-buffered-lines#1",
        "title": "Buffered lines",
        "visible": true,
        "kind": "single",
        "source": {
          "type": "geojson",
          "data": "data/local-buffered-lines.geojson"
        },
        "render": {
          "type": "fill",
          "paint": {
            "fill-color": "#ff6600",
            "fill-opacity": 0.35
          }
        },
        "metadata": {
          "webmapx:provenance": {
            "sourceLayerRefs": ["drawn-lines#1"],
            "operation": "buffer",
            "parameters": {
              "distance": 100,
              "units": "meter"
            }
          }
        }
      }
    ]
  },
  "tools": {
    "mainToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-left",
      "order": 10,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Tools",
        "position": "after"
      },
      "items": [
        {
          "id": "catalog",
          "type": "layerTree",
          "enabled": true,
          "title": "Catalog",
          "icon": "layers",
          "catalog": "main",
          "order": 10
        },
        {
          "id": "search",
          "type": "search",
          "enabled": true,
          "title": "Search",
          "icon": "search",
          "order": 20
        },
        {
          "id": "measure",
          "type": "measure",
          "enabled": true,
          "title": "Measure",
          "icon": "rulers",
          "order": 30
        },
        {
          "id": "settings",
          "type": "settings",
          "enabled": true,
          "title": "Settings",
          "icon": "gear",
          "order": 40
        },
        {
          "id": "geolocation",
          "type": "geolocation",
          "enabled": true,
          "title": "Geolocation",
          "icon": "crosshair",
          "order": 50
        }
      ]
    },
    "legendToolbar": {
      "type": "toolbar",
      "enabled": true,
      "position": "top-right",
      "order": 20,
      "orientation": "vertical",
      "panel": {
        "enabled": true,
        "label": "Legend",
        "position": "after",
        "opened": false
      },
      "items": [
        {
          "id": "legend",
          "type": "layerOverview",
          "enabled": true,
          "title": "Legend",
          "icon": "card-list",
          "order": 10
        }
      ]
    },
    "scale": {
      "type": "scaleControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 10,
      "maxWidth": 140
    },
    "attribution": {
      "type": "attributionControl",
      "enabled": true,
      "position": "bottom-right",
      "order": 20
    },
    "coordinates": {
      "type": "coordinates",
      "enabled": true,
      "position": "bottom-center",
      "order": 10
    },
    "navigation": {
      "type": "navigation",
      "enabled": true,
      "position": "bottom-left",
      "order": 10,
      "direction": "horizontal",
      "orientation": "vertical"
    },
    "zoomLevel": {
      "type": "zoomLevel",
      "enabled": true,
      "position": "bottom-left",
      "order": 20
    },
    "insetMap": {
      "type": "insetMap",
      "enabled": true,
      "position": "bottom-left",
      "order": 30,
      "zoomOffset": -4,
      "background": {
        "service": "xyz",
        "tiles": [
          "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
          "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
        ],
        "attribution": "&copy; OpenStreetMap contributors",
        "tileSize": 256
      }
    },
    "spinner": {
      "type": "spinner",
      "enabled": true,
      "position": "middle-center",
      "order": 10
    }
  }
}
